<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <%- include('partials/favicon') %>
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title><%= title %></title>
    <link rel="stylesheet" href="<%= asset('/theme.css') %>">
    <%- include('partials/dialog') %>
    <link rel="stylesheet" href="<%= asset('/exercises.css') %>">
</head>
<body>
    <%- include('partials/nav') %>

    <div class="container ex-page">
      <div class="ex-head">
        <h2>📋 Exercises in your log</h2>
        <a href="/logs" class="btn">← Logs</a>
      </div>
      <p class="ex-sub">Every name you have logged. Tap one for its records, graph and plateau check. <strong>Rename</strong> fixes a typo everywhere; <strong>Merge</strong> folds one name into another. Future logs of the old name then land on the new one. Nothing is deleted.</p>

      <% if (!list.length) { %>
        <p class="ex-empty">Nothing logged yet. Use the <a href="/workout">logger</a>.</p>
      <% } else { %>
        <label class="ex-find" for="ex-filter">Find an exercise</label>
        <input id="ex-filter" type="search" placeholder="Type to filter" autocomplete="off">
        <ul class="ex-list" id="ex-list">
          <% list.forEach(function (e) { %>
          <li class="ex-row" data-name="<%= e.name %>">
            <a class="ex-name" href="/logs/exercises/detail?name=<%= encodeURIComponent(e.name) %>"><%= e.name %></a>
            <div class="ex-meta"><%= e.sets %> set<%= e.sets === 1 ? '' : 's' %> · <%= e.sessions %> session<%= e.sessions === 1 ? '' : 's' %><% if (e.last) { %> · last <%= e.last %><% } %></div>
            <% if (e.similar.length) { %><div class="ex-similar">Also logged as: <%= e.similar.join(', ') %></div><% } %>
            <div class="ex-actions">
              <button type="button" class="mini" data-act="rename">Rename</button>
              <button type="button" class="mini" data-act="merge">Merge into…</button>
            </div>
          </li>
          <% }) %>
        </ul>
      <% } %>
    </div>

    <div class="sheet-bg" id="pick-bg" hidden>
      <div class="sheet" role="dialog" aria-modal="true" aria-labelledby="pick-title">
        <h3 id="pick-title">Merge into…</h3>
        <label for="pick-filter">Find the exercise to keep</label>
        <input id="pick-filter" type="search" autocomplete="off">
        <ul class="pick-list" id="pick-list"></ul>
        <div class="btns"><button type="button" id="pick-cancel">Cancel</button></div>
      </div>
    </div>

    <script type="application/json" id="ex-data"><%- JSON.stringify(list.map(function (e) { return { name: e.name, sets: e.sets }; })).replace(/</g, '\\u003c') %></script>
    <script src="<%= asset('/js/exercises-list.js') %>"></script>
</body>
</html>
